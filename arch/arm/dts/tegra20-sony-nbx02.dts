// SPDX-License-Identifier: GPL-2.0
/dts-v1/;

#include <dt-bindings/input/input.h>
#include "tegra20.dtsi"

/ {
        model = "Sony Tablet P (NBX02)";
        compatible = "sony,nbx02", "nvidia,tegra20";

	chosen {
		stdout-path = &uarta;
	};

	aliases {
		i2c0 = &pwr_i2c;

		mmc0 = &sdmmc4; /* eMMC */
		mmc1 = &sdmmc3; /* MicroSD */

		rtc0 = &pmic;
		rtc1 = "/rtc@7000e000";

		usb0 = &usb1;
	};

	memory {
		device_type = "memory";
		reg = <0x00000000 0x40000000>;
	};

	host1x@50000000 {
		dc@54200000 {
			rgb {
				status = "okay";

				port {
					dpi_output: endpoint {
						remote-endpoint = <&panel_input>;
					};
				};
			};
		};
	};

	pwm: pwm@7000a000 {
		status = "okay";
	};

	bsev@6001b000 {
		status = "okay";
	};

	pinmux@70000014 {
		pinctrl-names = "default";
		pinctrl-0 = <&state_default>;

		state_default: pinmux {
			ata {
				nvidia,pins = "ata", "atc", "atd", "ate";
				nvidia,function = "ide";
			};
			atb {
				nvidia,pins = "atb", "gma", "gme";
				nvidia,function = "sdio4";
			};
			cdev1 {
				nvidia,pins = "cdev1";
				nvidia,function = "plla_out";
			};
			cdev2 {
				nvidia,pins = "cdev2";
				nvidia,function = "osc";
			};
			crtp {
				nvidia,pins = "crtp";
				nvidia,function = "crt";
			};
			csus {
				nvidia,pins = "csus";
				nvidia,function = "vi_sensor_clk";
			};
			dap1 {
				nvidia,pins = "dap1";
				nvidia,function = "dap1";
			};
			dap2 {
				nvidia,pins = "dap2";
				nvidia,function = "dap2";
			};
			dap3 {
				nvidia,pins = "dap3";
				nvidia,function = "dap3";
			};
			dap4 {
				nvidia,pins = "dap4";
				nvidia,function = "dap4";
			};
			ddc {
				nvidia,pins = "ddc", "dtb", "dte", "spdi",
					"spdo";
				nvidia,function = "rsvd2";
			};
			dta {
				nvidia,pins = "dta", "dtc", "dtd", "lcsn", "ldc",
					"lm0", "lpp", "lpw1", "lvp0", "lvp1", "spif",
					"uac";
				nvidia,function = "rsvd4";
			};
			dtf {
				nvidia,pins = "dtf";
				nvidia,function = "i2c3";
			};
			gmb {
				nvidia,pins = "gmb", "gmd", "spia", "spib", "spic",
					"spid", "spie";
				nvidia,function = "gmi";
			};
			gmc {
				nvidia,pins = "gmc", "slxc", "slxd";
				nvidia,function = "spi4";
			};
			gpu {
				nvidia,pins = "gpu";
				nvidia,function = "pwm";
			};
			gpu7 {
				nvidia,pins = "gpu7";
				nvidia,function = "rtck";
			};
			gpv {
				nvidia,pins = "gpv", "slxa", "slxk";
				nvidia,function = "pcie";
			};
			hdint {
				nvidia,pins = "hdint";
				nvidia,function = "hdmi";
			};
			i2cp {
				nvidia,pins = "i2cp", "rm";
				nvidia,function = "i2c1";
			};
			irrx {
				nvidia,pins = "irrx", "irtx";
				nvidia,function = "uarta";
			};
			kbca {
				nvidia,pins = "kbca", "kbcb", "kbcc", "kbcd",
					"kbce", "kbcf";
				nvidia,function = "kbc";
			};
			ld0 {
				nvidia,pins = "ld0", "ld1", "ld2", "ld3", "ld4",
					"ld5", "ld6", "ld7", "ld8", "ld9",
					"ld10", "ld11", "ld12", "ld13", "ld14",
					"ld15", "ld16", "ld17", "ldi", "lhp0",
					"lhp1", "lhp2", "lhs", "lpw0", "lpw2",
					"lsc0", "lsc1", "lsck", "lsda", "lsdi",
					"lspi", "lvs";
				nvidia,function = "displaya";
			};
			lm1 {
				nvidia,pins = "lm1";
				nvidia,function = "rsvd3";
			};
			owc {
				nvidia,pins = "owc";
				nvidia,function = "owr";
			};
			pmc {
				nvidia,pins = "pmc";
				nvidia,function = "pwr_on";
			};
			pta {
				nvidia,pins = "pta";
				nvidia,function = "i2c2";
			};
			sdb {
				nvidia,pins = "sdb", "sdc", "sdd";
				nvidia,function = "sdio3";
			};
			sdio1 {
				nvidia,pins = "sdio1";
				nvidia,function = "sdio1";
			};
			spig {
				nvidia,pins = "spig", "spih";
				nvidia,function = "spi2_alt";
			};
			uaa {
				nvidia,pins = "uaa", "uab";
				nvidia,function = "mipi_hs";
			};
			uad {
				nvidia,pins = "uad";
				nvidia,function = "irda";
			};
			uca {
				nvidia,pins = "uca", "ucb";
				nvidia,function = "uartc";
			};
			uda {
				nvidia,pins = "uda";
				nvidia,function = "uartd";
			};
			conf_ata {
				nvidia,pins = "ata", "atb", "atc", "atd",
					"dap1", "dap3", "dap4", "dtb", "dtc",
					"dte", "dtf", "gma", "gmc",
					"gme", "gpu", "gpu7", "gpv", "i2cp",
					"pmc", "pta", "rm", "sdb", "slxd",
					"spdi", "spdo", "uac", "uda";
				nvidia,pull = <TEGRA_PIN_PULL_NONE>;
				nvidia,tristate = <TEGRA_PIN_DISABLE>;
			};
			conf_ate {
				nvidia,pins = "ate", "crtp", "gmb",
					"gmd", "slxc", "slxk";
				nvidia,pull = <TEGRA_PIN_PULL_NONE>;
				nvidia,tristate = <TEGRA_PIN_ENABLE>;
			};
			conf_cdev1 {
				nvidia,pins = "cdev1", "cdev2", "csus", "dap2",
					"dtd", "kbcb", "ld0", "ld1", "ld2", "ld3",
					"ld4", "ld5", "ld6", "ld7", "ld8", "ld9",
					"ld10", "ld11", "ld12", "ld13", "ld14",
					"ld15", "ld16", "ld17", "ldi", "lhp0",
					"lhp1", "lhp2", "lpp", "lvp1", "ck32",
					"ddrc", "pmca", "pmcb",	"pmcc", "pmcd",
					"xm2c", "xm2d";
				nvidia,pull = <TEGRA_PIN_PULL_DOWN>;
				nvidia,tristate = <TEGRA_PIN_DISABLE>;
			};
			conf_crtp {
				nvidia,pins = "spig", "spih", "hdint",
					"lcsn", "ldc", "lm1", "lpw1", "lsck",
					"lsda", "lsdi", "lvp0", "owc", "spic",
					"spie";
				nvidia,pull = <TEGRA_PIN_PULL_UP>;
				nvidia,tristate = <TEGRA_PIN_ENABLE>;
			};
			conf_dte {
				nvidia,pins = "spif", "spia", "spib", "spid";
				nvidia,pull = <TEGRA_PIN_PULL_DOWN>;
				nvidia,tristate = <TEGRA_PIN_ENABLE>;
			};
			conf_kbca {
				nvidia,pins = "ddc", "dta", "irrx", "irtx",
					"kbca", "kbcc", "kbcd", "kbce", "kbcf",
					"sdio1", "lhs", "lm0", "lpw0", "lpw2",
					"lsc0", "lsc1", "lspi", "lvs", "sdc",
					"sdd", "slxa", "uaa", "uab", "uad",
					"uca", "ucb", "pmce";
				nvidia,pull = <TEGRA_PIN_PULL_UP>;
				nvidia,tristate = <TEGRA_PIN_DISABLE>;
			};
			drive_ao1 {
				nvidia,pins = "drive_ao1", "drive_ao2", "drive_dbg", "drive_sdmmc2",
					"drive_vi1", "drive_vi2",  "drive_ddc";
				nvidia,pull-up-strength = <31>;
				nvidia,pull-down-strength = <31>;
				nvidia,schmitt = <TEGRA_PIN_ENABLE>;
				nvidia,high-speed-mode = <TEGRA_PIN_DISABLE>;
				nvidia,low-power-mode = <TEGRA_PIN_LP_DRIVE_DIV_1>;
				nvidia,slew-rate-rising = <TEGRA_PIN_SLEW_RATE_SLOWEST>;
				nvidia,slew-rate-falling = <TEGRA_PIN_SLEW_RATE_SLOWEST>;
			};
			drive_at1 {
				nvidia,pins = "drive_at1", "drive_at2", "drive_cdev2",
					"drive_csus", "drive_lcd2", "drive_sdio1",
					"drive_gma", "drive_gme";
				nvidia,pull-up-strength = <0>;
				nvidia,pull-down-strength = <0>;
				nvidia,schmitt = <TEGRA_PIN_ENABLE>;
				nvidia,high-speed-mode = <TEGRA_PIN_DISABLE>;
				nvidia,low-power-mode = <TEGRA_PIN_LP_DRIVE_DIV_1>;
				nvidia,slew-rate-rising = <TEGRA_PIN_SLEW_RATE_SLOWEST>;
				nvidia,slew-rate-falling = <TEGRA_PIN_SLEW_RATE_SLOWEST>;
			};
			drive_cdev1 {
				nvidia,pins = "drive_cdev1", "drive_dap1", "drive_dap3", "drive_dap4";
				nvidia,pull-up-strength = <0>;
				nvidia,pull-down-strength = <0>;
				nvidia,schmitt = <TEGRA_PIN_ENABLE>;
				nvidia,high-speed-mode = <TEGRA_PIN_DISABLE>;
				nvidia,low-power-mode = <TEGRA_PIN_LP_DRIVE_DIV_8>;
				nvidia,slew-rate-rising = <TEGRA_PIN_SLEW_RATE_SLOWEST>;
				nvidia,slew-rate-falling = <TEGRA_PIN_SLEW_RATE_SLOWEST>;
			};
			drive_dap2 {
				nvidia,pins = "drive_dap2", "drive_lcd1", "drive_spi", "drive_uaa",
					"drive_uab", "drive_uart2", "drive_uart3", "drive_crt",
					"drive_gmb", "drive_gmc", "drive_gmd", "drive_owr", "drive_uad";
				nvidia,pull-up-strength = <22>;
				nvidia,pull-down-strength = <18>;
				nvidia,schmitt = <TEGRA_PIN_DISABLE>;
				nvidia,high-speed-mode = <TEGRA_PIN_DISABLE>;
				nvidia,low-power-mode = <TEGRA_PIN_LP_DRIVE_DIV_1>;
				nvidia,slew-rate-rising = <TEGRA_PIN_SLEW_RATE_SLOWEST>;
				nvidia,slew-rate-falling = <TEGRA_PIN_SLEW_RATE_SLOWEST>;
			};
			drive_sdmmc3 {
				nvidia,pins = "drive_sdmmc3";
				nvidia,pull-up-strength = <4>;
				nvidia,pull-down-strength = <15>;
				nvidia,schmitt = <TEGRA_PIN_ENABLE>;
				nvidia,high-speed-mode = <TEGRA_PIN_DISABLE>;
				nvidia,low-power-mode = <TEGRA_PIN_LP_DRIVE_DIV_1>;
				nvidia,slew-rate-rising = <TEGRA_PIN_SLEW_RATE_SLOWEST>;
				nvidia,slew-rate-falling = <TEGRA_PIN_SLEW_RATE_SLOWEST>;
			};
			drive_xm2a {
				nvidia,pins = "drive_xm2a", "drive_xm2clk";
				nvidia,pull-up-strength = <31>;
				nvidia,pull-down-strength = <28>;
				nvidia,schmitt = <TEGRA_PIN_DISABLE>;
				nvidia,high-speed-mode = <TEGRA_PIN_DISABLE>;
				nvidia,low-power-mode = <TEGRA_PIN_LP_DRIVE_DIV_8>;
				nvidia,slew-rate-rising = <TEGRA_PIN_SLEW_RATE_SLOWEST>;
				nvidia,slew-rate-falling = <TEGRA_PIN_SLEW_RATE_FAST>;
			};
			drive_xm2c {
				nvidia,pins = "drive_xm2c", "drive_xm2d";
				nvidia,pull-up-strength = <31>;
				nvidia,pull-down-strength = <31>;
				nvidia,schmitt = <TEGRA_PIN_ENABLE>;
				nvidia,high-speed-mode = <TEGRA_PIN_DISABLE>;
				nvidia,low-power-mode = <TEGRA_PIN_LP_DRIVE_DIV_1>;
				nvidia,slew-rate-rising = <TEGRA_PIN_SLEW_RATE_SLOWEST>;
				nvidia,slew-rate-falling = <TEGRA_PIN_SLEW_RATE_FAST>;
			};
			drive_memcomp {
				nvidia,pins = "drive_memcomp";
				nvidia,pull-up-strength = <31>;
				nvidia,pull-down-strength = <31>;
				nvidia,schmitt = <TEGRA_PIN_ENABLE>;
				nvidia,high-speed-mode = <TEGRA_PIN_DISABLE>;
				nvidia,low-power-mode = <TEGRA_PIN_LP_DRIVE_DIV_8>;
				nvidia,slew-rate-rising = <TEGRA_PIN_SLEW_RATE_FASTEST>;
				nvidia,slew-rate-falling = <TEGRA_PIN_SLEW_RATE_FASTEST>;
			};
		};
	};

	uarta: serial@70006000 {
		status = "okay";
	};

	i2c@7000c400 {
		status = "okay";
		clock-frequency = <400000>;

		panel-upper@3d {
			compatible = "sony,tablet-p-panel";
			reg = <0x3d>;

			link2 = <&panel_lower>;

			reset-gpios = <&gpio TEGRA_GPIO(M, 6) GPIO_ACTIVE_LOW>;

			vdd-supply = <&vdd_3v3_lcd>;
			vio-supply = <&vio_1v8_lcd>;

			backlight = <&backlight_upper>;

			port {
				panel_input: endpoint {
					remote-endpoint = <&dpi_output>;
				};
			};
		};

		panel_lower: panel-lower@3f {
			compatible = "sony,tablet-p-panel";
			reg = <0x3f>;

			reset-gpios = <&gpio TEGRA_GPIO(M, 7) GPIO_ACTIVE_LOW>;

			vdd-supply = <&vdd_3v3_lcd>;
			vio-supply = <&vio_1v8_lcd>;

			backlight = <&backlight_lower>;
		};

	};

	pwr_i2c: i2c@7000d000 {
		status = "okay";
		clock-frequency = <100000>;

		pmic: tps6586x@34 {
			compatible = "ti,tps6586x";
			reg = <0x34>;
			interrupts = <GIC_SPI 86 IRQ_TYPE_LEVEL_HIGH>;

			ti,system-power-controller;

			#gpio-cells = <2>;
			gpio-controller;

			regulators {
				vcore_emmc: ldo5 {
					regulator-name = "vdd_ldo5,vcore_mmc";
					regulator-min-microvolt = <2850000>;
					regulator-max-microvolt = <2850000>;
				};
			};
		};
	};

	usb1: usb@c5000000 {
		status = "okay";
		dr_mode = "otg";
	};

	usb-phy@c5000000 {
		status = "okay";
		nvidia,xcvr-setup-use-fuses;
		nvidia,xcvr-lsfslew = <2>;
		nvidia,xcvr-lsrslew = <2>;
	};

	sdmmc3: sdhci@c8000400 {
		status = "okay";
		bus-width = <4>;

		cd-gpios = <&gpio TEGRA_GPIO(I, 5) GPIO_ACTIVE_LOW>;
		power-gpios = <&gpio TEGRA_GPIO(D, 1) GPIO_ACTIVE_HIGH>;

		vmmc-supply = <&vdd_3v3_sys>;
		vqmmc-supply = <&vdd_3v3_sys>;
	};

	sdmmc4: sdhci@c8000600 {
		status = "okay";
		bus-width = <8>;
		non-removable;

		vmmc-supply = <&vcore_emmc>;
		vqmmc-supply = <&vdd_3v3_sys>;
	};

	backlight_upper: backlight-upper {
		compatible = "pwm-backlight";

		pwms = <&pwm 0 2777777>;

		brightness-levels = <1 35 70 105 140 175 210 255>;
		default-brightness-level = <5>;
	};

	backlight_lower: backlight-lower {
		compatible = "pwm-backlight";

		pwms = <&pwm 1 2777777>;

		brightness-levels = <1 35 70 105 140 175 210 255>;
		default-brightness-level = <5>;
	};

	/* PMIC has a built-in 32KHz oscillator which is used by PMC */
	clk32k_in: clock-32k-in {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
		clock-output-names = "tps658621-out32k";
	};

	vdd_3v3_sys: regulator-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vdd_3v3_vs";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	vdd_3v3_lcd: regulator-lcd3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vdd_3v3_lcd";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio TEGRA_GPIO(M, 5) GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	vio_1v8_lcd: regulator-lcd1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vio_1v8_lcd";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&gpio TEGRA_GPIO(M, 4) GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};
};
